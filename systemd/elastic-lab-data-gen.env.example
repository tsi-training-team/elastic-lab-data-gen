# Copy to /etc/elastic-lab-data-gen.env and edit values.

REPO_DIR=/opt/elastic-lab-data-gen
PYTHON_BIN=/usr/bin/python3

ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=YOUR_PASSWORD

SEED=42
HOURS=24
INTERVAL_SECONDS=10

WEB_COUNT=300
AUTH_COUNT=200
ORDERS_COUNT=120
SYSTEM_COUNT=200

# Keep empty to omit --start-time (recommended for near-real-time continuous mode)
START_TIME=
